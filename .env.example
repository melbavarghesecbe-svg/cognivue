# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# 1 = never call the network; answer only from cache/llm (offline demo)
CACHE_ONLY=0
# Embeddings: BAAI/bge-small-en-v1.5 (default, ~70 MB download) or "hash" (offline, no download).
# With "hash", use a lower retrieval threshold, e.g. MIN_RETRIEVAL_SCORE=0.12
EMBED_MODEL=BAAI/bge-small-en-v1.5
MIN_RETRIEVAL_SCORE=0.35
